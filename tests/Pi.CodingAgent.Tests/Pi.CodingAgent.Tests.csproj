<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Differential test vectors captured from the TypeScript utils reference implementations. -->
    <None Include="utils-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Second slice: node path semantics, semver, version checks, clipboard routing, config/self-update. -->
    <None Include="core-utils-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Third slice: git source parsing (git.ts + hosted-git-info) and the changelog helpers. -->
    <None Include="git-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Fourth slice: the managed-tool downloader, the Windows self-update quarantine, and
         node:path.toNamespacedPath. -->
    <None Include="tools-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="zip-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="syntax-highlight-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="frontmatter-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Fifth slice: minimatch@10.2.6 (glob matching), which the model resolver's case-insensitive
         model-id globs depend on. -->
    <None Include="minimatch-corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sixth slice: core/model-resolver.ts, captured by importing the real source (the generator only
         rewrites its import header; see tools/gen-coding-agent-model-resolver-corpus.mjs). -->
    <None Include="model-resolver-corpus.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Pi.CodingAgent\Pi.CodingAgent.csproj" />
  </ItemGroup>
</Project>
